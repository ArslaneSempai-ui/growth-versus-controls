{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "docs/js",
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "src/situation.ts",
    "src/arbitrage.ts",
    "src/interval.ts",
    "src/cli.ts",
    "src/emprunts/economics/model.ts",
    "src/emprunts/economics/alerts.ts",
    "src/emprunts/economics/regulations.ts",
    "src/emprunts/economics/calibrate.ts",
    "src/emprunts/economics/interval.ts",
    "src/emprunts/economics/cli.ts"
  ]
}
